{
  "name": "CHARLTON-MD",
  "description": "This is a simple whatsapp bot built with nodejs to make your WhatsApp enjoyable",
  "keywords": [
    "bot",
    "whatsapp",
    "charlton",
    "whatsapp-stickers",
    "anime",
    "whatsapp-bot",
    "whatsapp-sticker-bot",
    "whatsapp-botto",
    "baileys",
    "baileys-md",
    "md-bot",
    "pairing-site",
    "session"
  ],
  "website": "bot-deployer--otienojunior806.replit.app ",
  "repository": "https://github.com/roy107roy12-netizen/Whatsapp-bot.git",
  "logo": "https://i.ibb.co/rK0G8VVm/005db45ad93c.jpg",
  "success_url": "/",

  "env": {
    "OWNER_NUMBER": {
      "description": "Bot owner phone number without + or spaces. Example: 254712345678",
      "required": false
    },

    "SESSION_ID": {
      "description": "Your WhatsApp session ID",
      "required": true
    },

    "DATABASE_URL": {
      "description": "Insert your database URL",
      "value": "",
      "required": false
    },

    "AUTOVIEW_STATUS": {
      "description": "Auto view WhatsApp status (true/false)",
      "value": "true",
      "required": false
    },

    "AUTOLIKE_STATUS": {
      "description": "Auto like WhatsApp status (true/false)",
      "value": "true",
      "required": false
    },

    "STATUS_LIKE_EMOJIS": {
      "description": "Emojis to use for liking status (comma-separated)",
      "value": "💚,🔥",
      "required": false
    },

    "PREFIX": {
      "description": "Bot command prefix",
      "value": ".",
      "required": false
    },

    "BOT_EXPIRATION_DATE": {
      "description": "Choose your preferred bot expiration date in the format dd/mm/yy",
      "value": "11/03/2027",
      "required": false
    },

    "BOT_PIC": {
      "description": "Bot profile picture URL",
      "value": "https://i.ibb.co/rK0G8VVm/005db45ad93c.jpg",
      "required": false
    },

    "BOT_NAME": {
      "description": "Bot display name",
      "value": "CHARLTON-MD",
      "required": false
    },

    "AUTO_SOCIAL_DOWNLOAD": {
      "description": "When enabled true bot will automatically download social media videos when you share the url example for tiktok instagram youtube and many more",
      "value": "false",
      "required": false
    },

    "OWNER_NAME": {
      "description": "Your bot owner name",
      "value": "Charlton",
      "required": false
    },

    "MODE": {
      "description": "Bot operation mode (public/private)",
      "value": "public",
      "required": false
    }
  },

  "buildpacks": [
    {
      "url": "https://github.com/heroku/heroku-buildpack-nodejs.git"
    }
  ],

  "stack": "heroku-26"
}
