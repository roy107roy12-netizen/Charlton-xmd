{
  "name": "Charlton-XMD",
  "description": "A simple WhatsApp bot using Baileys",
  "repository": "https://github.com/roy107roy12-netizen/Charlton-xmd",
  "keywords": ["whatsapp", "bot", "baileys", "charlton"],
  "buildpacks": [
    {
      "url": "heroku/nodejs"
    }
  ],
  "env": {
    "SESSION": {
      "description": "Your WhatsApp session string",
      "required": true
    },
    "OWNER_NUMBER": {
      "description": "Your WhatsApp number (with country code)",
      "required": true
    },
    "PREFIX": {
      "description": "Bot command prefix",
      "value": ".",
      "required": false
    },
    "BOTNAME": {
      "description": "Bot name",
      "value": "CHARLTON-XMD",
      "required": false
    },
    "BOT_MODE": {
      "description": "Bot mode (public/private)",
      "value": "public",
      "required": false
    },
    "BOT_TIMEZONE": {
      "description": "Bot timezone",
      "value": "Africa/Nairobi",
      "required": false
    }
  },
  "formation": {
    "web": {
      "quantity": 1,
      "size": "free"
    }
  }
}
