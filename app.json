{
  "name": "Whatsapp-bot",
  "description": "This is a simple WhatsApp bot built with Node.js using Baileys for automation and fun features",
  "keywords": [
    "bot",
    "whatsapp",
    "whatsapp-bot",
    "baileys",
    "md-bot",
    "automation"
  ],
  "website": "https://github.com/roy107roy12-netizen/Whatsapp-bot",
  "repository": "https://github.com/roy107roy12-netizen/Whatsapp-bot",
  "logo": "https://i.ibb.co/PsZnb9NH/0d81ac6b1fb1.jpg",
  "success_url": "/",
  "env": {
    "OWNER_NUMBER": {
      "description": "Bot owner phone number without + or spaces. Example: 2547XXXXXXXX",
      "required": false
    },
    "SESSION": {
      "description": "Your WhatsApp session ID (required to run bot)",
      "required": true
    },
    "DATABASE_URL": {
      "description": "Database URL (optional)",
      "required": false,
      "value": ""
    },
    "AUTOVIEW_STATUS": {
      "description": "Auto view WhatsApp status (true/false)",
      "value": "true",
      "required": false
    },
    "AUTOLIKE_STATUS": {
      "description": "Auto like WhatsApp status (true/false)",
      "value": "true",
      "required": false
    },
    "STATUS_LIKE_EMOJIS": {
      "description": "Emojis for auto status like (comma separated)",
      "value": "💚,🫟",
      "required": false
    },
    "PREFIX": {
      "description": "Bot command prefix",
      "value": ".",
      "required": false
    },
    "BOT_EXPIRATION_DATE": {
      "description": "Bot expiration date (dd/mm/yy)",
      "value": "11/03/2027",
      "required": false
    },
    "BOT_PIC": {
      "description": "Bot profile picture URL",
      "value": "https://i.ibb.co/PsZnb9NH/0d81ac6b1fb1.jpg",
      "required": false
    },
    "BOTNAME": {
      "description": "Bot display name",
      "value": "Whatsapp-bot",
      "required": false
    },
    "AUTO_SOCIAL_DOWNLOAD": {
      "description": "Auto download social media videos (true/false)",
      "value": "false",
      "required": false
    },
    "OWNER_NAME": {
      "description": "Owner name",
      "value": "Keith",
      "required": false
    },
    "MODE": {
      "description": "Bot mode (public/private)",
      "value": "public",
      "required": false
    }
  },
  "buildpacks": [
    {
      "url": "https://github.com/heroku/heroku-buildpack-nodejs.git"
    }
  ],
  "stack": "heroku-24"
}
