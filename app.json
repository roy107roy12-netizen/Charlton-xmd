{
  "name": "Netizen WhatsApp Bot Pairing Site",
  "description": "WhatsApp Bot with session pairing UI and admin panel - Deploy on Heroku",
  "repository": "https://github.com/roy107roy12-netizen/Whatsapp-bot",
  "keywords": ["whatsapp", "bot", "baileys", "nodejs", "pairing", "session"],
  "image": "heroku/nodejs",
  "buildpacks": [
    {
      "url": "heroku/nodejs"
    }
  ],
  "env": {
    "NODE_ENV": {
      "description": "Node environment (production)",
      "value": "production",
      "required": true
    },
    "PORT": {
      "description": "Server port (Heroku will auto-assign)",
      "value": "3000",
      "required": false
    },
    "SESSION_ID": {
      "description": "Session identifier for WhatsApp",
      "value": "default_session",
      "required": false
    },
    "PREFIX": {
      "description": "Command prefix for bot commands",
      "value": ".",
      "required": false
    },
    "OWNER_NUMBER": {
      "description": "Owner's WhatsApp number (with country code, e.g., 254712345678)",
      "value": "your_number_here",
      "required": true
    }
  },
  "addons": [],
  "scripts": {
    "postdeploy": "npm install"
  },
  "formation": {
    "web": {
      "quantity": 1,
      "size": "free"
    }
  },
  "success_url": "/"
}
